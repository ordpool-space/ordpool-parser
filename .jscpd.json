{
  "path": ["src"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-commonjs/**",
    "**/*.spec.ts",
    "**/*.test.ts",
    "src/lib/brotli-decode.ts",
    "src/rune/src/**",
    "src/cat21/mooncat-parser.ts",
    "src/cat21/mooncat-parser.traits.ts",
    "src/cat21/mooncat-parser.designs.ts",
    "src/cat21/mooncat-parser.colors.ts"
  ],
  "minLines": 5,
  "minTokens": 50,
  "maxLines": 100000,
  "maxSize": "10mb",
  "threshold": 0,
  "reporters": ["console"],
  "gitignore": true,
  "ignorePattern": ["import\\s[^;]*?\\sfrom\\s'[^']+';"]
}
